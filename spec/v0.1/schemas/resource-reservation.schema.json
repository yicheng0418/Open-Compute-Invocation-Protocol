{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocip.dev/spec/v0.1/schemas/resource-reservation.schema.json",
  "title": "OCIP Resource Reservation Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "reservation_id", "request_id", "provider_id", "capability_id", "state", "created_at", "expires_at"],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "reservation_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "state": {"type": "string", "enum": ["offered", "confirmed", "consumed", "released", "expired", "rejected"]},
    "capacity": {"type": "object", "properties": {"units": {"type": "number", "exclusiveMinimum": 0}, "unit_name": {"type": "string"}}},
    "price_quote": {"type": "object", "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string"}, "basis": {"type": "string"}}},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "terms_ref": {"type": "string"},
    "signature": {"type": "object"},
    "extensions": {"type": "object"}
  }
}