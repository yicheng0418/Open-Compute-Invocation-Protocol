{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocip.dev/spec/v0.1/schemas/provider-manifest.schema.json",
  "title": "OCIP Provider Manifest",
  "description": "A provider's signed description of its identity, capabilities and service endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "provider_id", "manifest_version", "updated_at", "endpoint", "capabilities"],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "provider_id": {"type": "string", "minLength": 1},
    "manifest_version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "endpoint": {"type": "string", "format": "uri"},
    "region": {"type": "string"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "workload_kinds"],
        "properties": {
          "capability_id": {"type": "string"},
          "workload_kinds": {"type": "array", "items": {"type": "string"}},
          "accelerators": {"type": "array", "items": {"type": "string"}},
          "memory_bytes": {"type": "integer", "minimum": 0},
          "runtime_names": {"type": "array", "items": {"type": "string"}},
          "supported_precisions": {"type": "array", "items": {"type": "string"}},
          "benchmark_profile_ref": {"type": "string"},
          "max_concurrency": {"type": "integer", "minimum": 1}
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {"type": "string", "enum": ["available", "degraded", "unavailable", "unknown"]},
        "offer_ref": {"type": "string"},
        "price_model": {"type": "string"},
        "currency": {"type": "string"},
        "health_updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_regions": {"type": "array", "items": {"type": "string"}},
        "attestation_profiles": {"type": "array", "items": {"type": "string"}},
        "transport_security": {"type": "array", "items": {"type": "string"}}
      }
    },
    "signature": {"type": "object", "description": "Signature envelope format remains to be specified."},
    "extensions": {"type": "object"}
  }
}